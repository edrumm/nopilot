{
    "manifest_version": 3,
    "name": "Nopilot",
    "version": "1.0",
    "description": "remove AI assistant popups and overviews from your Firefox webpages",
    "icons": {
        "48": "icons/border-48.png"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "@nopilot",
            "data_collection_permissions": {
                "required": [
                    "none"
                ]
            }
        }
    },
    "content_scripts": [
        {
            "matches": [
                "*://*.mozilla.org/*"
            ],
            "js": [
                "src/nopilot.js"
            ]
        }
    ]
}